@startuml SecuenciaAccionNocturna
skinparam sequenceMessageAlign center
skinparam maxMessageSize 220
autonumber

actor Cliente
participant "partida : Partida" as P
participant "fase : FaseNocturna" as F
participant "jugadores : Jugadores" as J
participant "detective : Jugador" as D
participant "estado : Vivo" as E
participant "rol : Detective" as R
participant "objetivo : Jugador" as O
participant "resolucion : ResolucionNocturna" as RN

== Eleccion (ruteo por Partida, double dispatch) ==

Cliente -> P : elegirInvestigar(detective, objetivo)
activate P
P -> F : elegirInvestigar(detective, objetivo)
activate F
F -> D : elegirInvestigar(objetivo)
activate D
D -> R : elegirInvestigar(objetivo)
activate R
note over R
  Valida la regla del Detective:
  no repetir ultimoInvestigado
  y objetivo vivo (#9)
end note
R --> D
deactivate R
D --> F
deactivate D
F --> P
deactivate F
P --> Cliente
deactivate P

== Resolucion de la fase ==

Cliente -> P : resolverFaseActual()
activate P
P -> F : resolver()
activate F
F -> RN : registrarAtaque(victimaElegida)
F -> J : porCadaVivo(jugador -> jugador.actuarEnNoche(resolucion))
activate J

loop por cada jugador vivo
  J -> D : actuarEnNoche(resolucion)
  activate D
  D -> E : actuarEnNoche(detective, resolucion)
  activate E
  E -> D : ejecutarAccionNocturna(resolucion)
  D -> R : actuarEnNoche(resolucion)
  activate R
  R -> O : resultadoAlSerInvestigado()
  activate O
  O --> R : bando
  deactivate O
  R --> D
  deactivate R
  E --> D
  deactivate E
  D --> J
  deactivate D
end

deactivate J
F -> RN : resolver()
activate RN
RN --> F : Optional<Jugador>
deactivate RN
F --> P : RegistroRonda
deactivate F
P --> Cliente
deactivate P

@enduml
