@startuml
title seReparteUnMazoControladoSeJuegaLaNocheYLaVictimaNoProtegidaMuere

actor "TestIntegrales" as Test

participant ":RepartidorRoles" as Repartidor
participant ":Jugadores" as Jugadores
participant "Jugador\nMauro : Mafioso" as Mauro
participant "Jugador\nAgus : Ciudadano" as Agus
participant "Jugador\nJose : Medico" as Jose
participant "Jugador\nRicardo : Ciudadano" as Ricardo
participant ":Partida" as Partida
participant ":FaseNocturna" as FaseNocturna
participant "ResolucionNocturna" as ResolucionNocturna
participant ":RegistroPartida" as RegistroPartida

== Preparacion del reparto ==

Test -> Repartidor : new RepartidorRoles(roles -> {})
activate Repartidor

Test -> Repartidor : repartir(nombres, roles)

Repartidor -> Jugadores : new Jugadores()
activate Jugadores

Repartidor -> Mauro : new Jugador("Mauro", new Mafioso())
activate Mauro
Mauro --> Repartidor : Mauro creado
deactivate Mauro
Repartidor -> Jugadores : agregar(Mauro)

Repartidor -> Agus : new Jugador("Agus", new Ciudadano())
activate Agus
Agus --> Repartidor : Agus creado
deactivate Agus
Repartidor -> Jugadores : agregar(Agus)

Repartidor -> Jose : new Jugador("Jose", new Medico())
activate Jose
Jose --> Repartidor : Jose creado
deactivate Jose
Repartidor -> Jugadores : agregar(Jose)

Repartidor -> Ricardo : new Jugador("Ricardo", new Ciudadano())
activate Ricardo
Ricardo --> Repartidor : Ricardo creado
deactivate Ricardo
Repartidor -> Jugadores : agregar(Ricardo)

Jugadores --> Repartidor : jugadores cargados
deactivate Jugadores

Repartidor --> Test : jugadores
deactivate Repartidor

== Obtener jugadores vivos ==

Test -> Test : vivosDe(jugadores)

Test -> Jugadores : porCadaVivo(vivos::add)
activate Jugadores

Jugadores -> Mauro : estaVivo()
Mauro --> Jugadores : true
Jugadores -> Test : vivos.add(Mauro)

Jugadores -> Agus : estaVivo()
Agus --> Jugadores : true
Jugadores -> Test : vivos.add(Agus)

Jugadores -> Jose : estaVivo()
Jose --> Jugadores : true
Jugadores -> Test : vivos.add(Jose)

Jugadores -> Ricardo : estaVivo()
Ricardo --> Jugadores : true
Jugadores -> Test : vivos.add(Ricardo)

Jugadores --> Test : vivos = [Mauro, Agus, Jose, Ricardo]
deactivate Jugadores

Test -> Test : mafioso = vivos.get(0)
Test -> Test : victima = vivos.get(1)
Test -> Test : medico = vivos.get(2)

== Creación de la partida ==

Test -> Partida : new Partida(jugadores)
activate Partida

Partida -> FaseNocturna : new FaseNocturna(...)
activate FaseNocturna
FaseNocturna --> Partida : fase nocturna inicial
deactivate FaseNocturna

Partida -> RegistroPartida : new RegistroPartida()
activate RegistroPartida
RegistroPartida --> Partida : registro creado
deactivate RegistroPartida

Partida --> Test : partida creada
deactivate Partida

== La mafia elige víctima ==

Test -> Partida : registrarVotoMafia(victima)
activate Partida

Partida -> FaseNocturna : registrarVotoMafia(Agus)
activate FaseNocturna

FaseNocturna -> ResolucionNocturna : registrarAtaque(Agus)
activate ResolucionNocturna
ResolucionNocturna --> FaseNocturna : ataque registrado
deactivate ResolucionNocturna

FaseNocturna --> Partida : voto mafia registrado
deactivate FaseNocturna

Partida --> Test : registro completado
deactivate Partida

== Resolución de la noche ==

Test -> Partida : resolverFaseActual()
activate Partida

Partida -> FaseNocturna : resolver()
activate FaseNocturna

FaseNocturna -> ResolucionNocturna : resolver()
activate ResolucionNocturna

ResolucionNocturna -> Agus : eliminar()
activate Agus
Agus --> ResolucionNocturna : estado = Eliminado\ncarta revelada
deactivate Agus

ResolucionNocturna --> FaseNocturna : víctima eliminada
deactivate ResolucionNocturna

FaseNocturna -> RegistroPartida : registrar("Agus fue eliminado")
activate RegistroPartida
RegistroPartida --> FaseNocturna : eliminación registrada
deactivate RegistroPartida

FaseNocturna --> Partida : noche resuelta
deactivate FaseNocturna

Partida -> FaseNocturna : avanzar fase
Partida --> Test : fase actual resuelta
deactivate Partida

== Verificaciones del test ==

Test -> Mauro : estaVivo()
activate Mauro
Mauro --> Test : true
deactivate Mauro

Test -> Agus : estaVivo()
activate Agus
Agus --> Test : false
deactivate Agus

Test -> Jose : estaVivo()
activate Jose
Jose --> Test : true
deactivate Jose

Test -> Partida : resumen()
activate Partida
Partida -> RegistroPartida : resumen()
activate RegistroPartida
RegistroPartida --> Partida : "... Agus fue eliminado ..."
deactivate RegistroPartida
Partida --> Test : resumen con "Agus fue eliminado"
deactivate Partida

@enduml